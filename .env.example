# VaultBase Environment Configuration
# ======================================
# Copy this file to .env and fill in the values.
# NEVER commit real secrets to version control!
#
# For production, use secrets management (Docker secrets, HashiCorp Vault, AWS Secrets Manager, etc.)

# =============================================================================
# MODE
# =============================================================================
# development | production
NODE_ENV=development

# =============================================================================
# SECURITY - CRITICAL
# =============================================================================
# Generate strong secrets for production:
#   JWT_SECRET: 256-bit minimum (e.g., openssl rand -hex 32)
#   OTP_SECRET: 256-bit minimum (e.g., openssl rand -hex 32)

# JWT signing secret for session tokens
# CHANGE THIS IN PRODUCTION - use a secure random value
JWT_SECRET=vaultbase-dev-jwt-secret-change-in-prod

# HMAC secret for OTP generation and verification
# CHANGE THIS IN PRODUCTION - use a secure random value
OTP_SECRET=vaultbase-dev-otp-secret-change-in-prod

# =============================================================================
# POSTGRESQL DATABASE
# =============================================================================
# Connection settings for PostgreSQL
# In Docker Compose, use service names (postgres) as host
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vaultbase
POSTGRES_USER=vaultbase_admin
POSTGRES_PASSWORD=vaultbase_dev_secret

# Alternative: Use DATABASE_URL (takes precedence over individual settings)
# DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# =============================================================================
# REDIS CACHE
# =============================================================================
# Connection settings for Redis (OTP, WebAuthn challenges, rate limiting)
# In Docker Compose, use service names (redis) as host
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Alternative: Use REDIS_URL (takes precedence over individual settings)
# REDIS_URL=redis://:password@host:port

# =============================================================================
# WEB AUTHENTICATION (WebAuthn/FIDO2)
# =============================================================================
# Configure these for production deployment with HTTPS
WEBAUTHN_RP_ID=localhost                    # RP ID (domain without protocol)
WEBAUTHN_RP_NAME=VaultBase                  # Relying Party display name
WEBAUTHN_ORIGIN=http://localhost:5000       # Origin (scheme://domain:port)

# For production HTTPS:
# WEBAUTHN_RP_ID=vaultbase.example.com
# WEBAUTHN_ORIGIN=https://vaultbase.example.com

# =============================================================================
# CORS & BROWSER ORIGINS
# =============================================================================
# Comma-separated list of allowed origins for CORS
# - http://localhost:8080 = DemoBank
# - http://localhost:3000 = Dashboard
# - chrome-extension://* = VaultBase Chrome Extension
# - https://your-domain.com = Production frontend
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,chrome-extension://*

# =============================================================================
# EMAIL / SMTP (OTP Delivery)
# =============================================================================
# SMTP configuration for sending OTP codes via email
# Leave empty for Ethereal test accounts (development only)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="VaultBase Security" <security@vaultbase.local>

# =============================================================================
# BACKEND SERVER
# =============================================================================
PORT=5000

# =============================================================================
# DEMOBANK (Reference Application)
# =============================================================================
DEMO_BANK_PORT=8080
# URL of backend API for DemoBank to connect to
# In Docker Compose: http://backend:5000
BACKEND_URL=http://localhost:5000

# =============================================================================
# DASHBOARD (Security Control Center)
# =============================================================================
DASHBOARD_PORT=3000
# Backend API URL for Dashboard frontend
REACT_APP_API_URL=http://localhost:5000
REACT_APP_BACKEND_URL=http://localhost:5000

# =============================================================================
# SESSION CONFIGURATION
# =============================================================================
# Token lifetime in seconds (default: 3600 = 1 hour)
ACCESS_TTL_S=3600

# =============================================================================
# OPTIONAL: GOOGLE FACE VERIFICATION
# =============================================================================
# For cloud-based face verification (requires Google Cloud project)
# GOOGLE_FACE_API_KEY=your-google-face-api-key
