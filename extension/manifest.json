{
  "manifest_version": 3,
  "name": "VaultBase",
  "version": "1.0.0",
  "description": "4-Factor Biometric MFA Authentication System",
  "permissions": ["storage", "activeTab", "scripting", "cookies", "tabs"],
  "host_permissions": [
    "http://localhost:5000/*",
    "http://localhost:8080/*",
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["libs/face-api.min.js", "libs/model-loader.js", "models/*", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://localhost:5000 blob: data: chrome-extension://*;"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
